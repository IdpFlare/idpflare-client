{
  "name": "@idpflare/client",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "OAuth 2.0 / OpenID Connect client library for IDPFlare",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "oauth",
    "cloudflare",
    "oidc",
    "openid-connect",
    "authentication",
    "idpflare",
    "pkce"
  ],
  "author": "IDPFlare <support@idpflare.com>",
  "license": "Polyform-Strict-1.0.0",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "typescript": "^5.4.5"
  }
}